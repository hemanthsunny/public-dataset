# Supabase — from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only, never expose to the browser. Used by Netlify scheduled
# functions and server actions that must bypass RLS (e.g. dispatching
# alerts on behalf of all subscribers).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode — auto-enabled when Supabase URL is missing/placeholder.
# Set to "true" to force demo auth, or "false" to require real Supabase.
# NEXT_PUBLIC_DEMO_MODE=true
#
# Demo login (shown on /login when demo mode is on):
#   email:    demo@publicdata.agents
#   password: DemoPass123!

# Companies House (free — register at https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Outbound alert delivery
# Per-user Slack webhook URLs are stored in Supabase (delivery_channels
# table); this is only a fallback/admin alert channel.
ADMIN_ALERT_SLACK_WEBHOOK_URL=

# Email fallback delivery (Resend — https://resend.com)
RESEND_API_KEY=your-resend-api-key
ALERTS_FROM_EMAIL=alerts@yourdomain.com

# WhatsApp delivery via Twilio (optional — Agent delivery channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cron/function auth — Netlify scheduled functions send this header so the
# function can distinguish a real scheduled run from a public request.
INTERNAL_FUNCTION_SECRET=generate-a-long-random-string
